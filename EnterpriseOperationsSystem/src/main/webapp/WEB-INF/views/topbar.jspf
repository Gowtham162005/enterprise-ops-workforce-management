

<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>


<style>
    * {
        box-sizing: border-box;
    }

    .topbar {
        position: fixed;
        top: 0;
        left: 240px;
        right: 0;
        height: 65px;
        padding: 0 30px;
        background: #ffffff;
        border-bottom: 1px solid #e5e7eb;
        z-index: 900;
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-width: 0;
    }

    .page-title {
        min-width: 0;
        font-size: 18px;
        font-weight: 700;
        color: #111827;
    }

    .user-section {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .user-details {
        min-width: 0;
        text-align: right;
    }

    .user-name {
        font-size: 14px;
        font-weight: 700;
        color: #111827;
        overflow-wrap: anywhere;
    }

    .user-role {
        margin-top: 2px;
        font-size: 11px;
        color: #6b7280;
        text-transform: uppercase;
    }

    .user-avatar {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #2563eb;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        font-weight: 700;
    }

    /*
     * Sidebar is 220px on screens up to 600px.
     * Between 601px and 700px, it remains 240px.
     */
    @media (max-width: 700px) {
        .topbar {
            padding: 0 15px;
        }

        .page-title {
            font-size: 15px;
        }

        .user-section {
            gap: 8px;
        }

        .user-name {
            font-size: 12px;
        }

        .user-role {
            font-size: 10px;
        }

        .user-avatar {
            width: 32px;
            height: 32px;
            font-size: 13px;
        }
    }

    @media (max-width: 600px) {
        .topbar {
            left: 220px;
            padding: 0 10px;
        }

        .page-title {
            font-size: 13px;
        }

        .user-section {
            gap: 6px;
        }

        .user-name {
            font-size: 11px;
        }

        .user-role {
            font-size: 9px;
        }

        .user-avatar {
            width: 29px;
            height: 29px;
            font-size: 12px;
        }
    }
</style>

<div class="topbar">

    <div class="page-title">
        Enterprise Operations
    </div>

    <div class="user-section">

        <div class="user-details">

            <div class="user-name">
                <c:choose>
                    <c:when test="${not empty sessionScope.username}">
                        <c:out value="${sessionScope.username}" />
                    </c:when>

                    <c:otherwise>
                        User
                    </c:otherwise>
                </c:choose>
            </div>

            <div class="user-role">
                <c:choose>
                    <c:when test="${not empty sessionScope.role}">
                        <c:out value="${sessionScope.role}" />
                    </c:when>

                    <c:otherwise>
                        USER
                    </c:otherwise>
                </c:choose>
            </div>

        </div>

        <div class="user-avatar">
            <c:choose>
                <c:when test="${not empty sessionScope.username}">
                    <c:out value="${fn:toUpperCase(fn:substring(sessionScope.username, 0, 1))}" />
                </c:when>

                <c:otherwise>
                    U
                </c:otherwise>
            </c:choose>
        </div>

    </div>

</div>
